# Anthropic Claude API key — get one at https://console.anthropic.com
# Used by the AI guidance steps (research question help, design advice, etc.)
ANTHROPIC_API_KEY=

# Optional: override the default model
ANTHROPIC_MODEL=claude-opus-4-8

# Postgres connection string.
# On Railway, add a Postgres plugin and reference it as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://user:password@localhost:5432/sciplan
