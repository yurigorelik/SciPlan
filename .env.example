# Anthropic Claude API key — get one at https://console.anthropic.com
# Used by the final AI review that finalizes the study.
ANTHROPIC_API_KEY=

# Optional: override the default model
ANTHROPIC_MODEL=claude-opus-4-8

# Postgres connection string.
# On Railway, add a Postgres plugin and reference it as ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgresql://user:password@localhost:5432/sciplan

# ── Authentication (Auth.js / NextAuth) ──────────────────────────────────────
# Required in production. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (optional). Create credentials at
# https://console.cloud.google.com/apis/credentials and set the redirect URI to
#   https://YOUR_DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Microsoft / Entra ID OAuth (optional). Register an app at
# https://portal.azure.com → App registrations, redirect URI:
#   https://YOUR_DOMAIN/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ID=
AUTH_MICROSOFT_SECRET=
# Tenant: "common" (any account), "organizations", or a specific tenant ID.
AUTH_MICROSOFT_TENANT=common

# ── Administrator access ─────────────────────────────────────────────────────
# Comma-separated emails always granted the ADMIN role on sign-in.
ADMIN_EMAILS=yurigorelik@gmail.com

# The built-in username/password admin (always available, even without OAuth).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SciPlan2026!
# Synthetic email used to store the credentials admin as a user row.
ADMIN_EMAIL=admin@sciplan.local
