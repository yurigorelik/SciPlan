generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A research plan, identified by a shareable slug. No user accounts yet —
// anyone with the link can view/continue the plan.
model Plan {
  id        String   @id @default(cuid())
  title     String   @default("Untitled research plan")
  // The full wizard state as JSON: answers per step, calculations, AI notes.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
